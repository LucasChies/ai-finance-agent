# Copie para .env e preencha. NUNCA commite o arquivo .env.

# Endpoint e implantação do Azure AI Foundry (não são segredos)
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=NOME-DA-IMPLANTACAO
AZURE_OPENAI_API_VERSION=2024-10-21

# Opção A (recomendada): chave no Azure Key Vault
# Requer `az login` localmente e a função "Key Vault Secrets User" no Key Vault.
KEY_VAULT_URL=https://quantra-kv.vault.azure.net/
# AZURE_OPENAI_KEY_SECRET_NAME=AZURE-OPENAI-API-KEY   (padrão, só mude se o nome for outro)

# Opção B (uso local, sem Key Vault): chave direta
# AZURE_OPENAI_API_KEY=SUA-CHAVE-AQUI
